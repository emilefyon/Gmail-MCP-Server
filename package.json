{
  "name": "@emilefyon/gmail-mcp",
  "version": "2.0.0",
  "description": "Minimal Gmail MCP server: search, read, download attachments, create drafts. Read + compose scopes only.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "test": "tsc && node --test dist/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "!dist/*.test.js",
    "README.md"
  ],
  "keywords": [
    "gmail",
    "mcp",
    "claude",
    "model-context-protocol"
  ],
  "author": "emilefyon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emilefyon/Gmail-MCP-Server.git"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "google-auth-library": "11.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
